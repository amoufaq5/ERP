  @@map("loyalty_programs")
}

model LoyaltyMember {
  id        String         @id @default(cuid())
  programId String
  program   LoyaltyProgram @relation(fields: [programId], references: [id])
  accountId String?
  account   Account?       @relation(fields: [accountId], references: [id])
