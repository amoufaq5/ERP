model Territory {
  id           String          @id @default(cuid())
  name         String
  nameAr       String?
  code         String?         @unique
  description  String?
  level        TerritoryLevel  @default(REGION)
  parentId     String?
  parent       Territory?      @relation("TerritoryHierarchy", fields: [parentId], references: [id])
