  description String?
  date        DateTime      @default(now())

  @@map("loyalty_transactions")
}

// ==================== ATS ====================

model Job {
  id              String    @id @default(cuid())
  title           String
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  location        String?
  type            String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN, REMOTE
  status          String    @default("DRAFT") // DRAFT, OPEN, ON_HOLD, CLOSED
  description     String?
  requirements    String?
  salaryMin       Float?
  salaryMax       Float?
  benefits        String?
  postedDate      DateTime?
  closingDate     DateTime?
  hiringManagerId String?
  hiringManager   User?     @relation(fields: [hiringManagerId], references: [id])
  createdAt       DateTime  @default(now())

  applications Application[]

  @@map("jobs")
}

model Candidate {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  linkedIn       String?
  resumeUrl      String?
  source         String   @default("WEBSITE") // WEBSITE, LINKEDIN, REFERRAL, AGENCY, JOB_BOARD
  status         String   @default("NEW") // NEW, SCREENING, SHORTLISTED, INTERVIEW, OFFER, HIRED, REJECTED
  currentCompany String?
  currentTitle   String?
  expectedSalary Float?
  rating         Int?
  notes          String?
  createdAt      DateTime @default(now())

  applications Application[]

  @@map("candidates")
}

model Application {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  status      String    @default("APPLIED") // APPLIED, SCREENING, SHORTLISTED, INTERVIEW, OFFER, HIRED, REJECTED
  appliedDate DateTime  @default(now())
  coverLetter String?
  score       Int?
  createdAt   DateTime  @default(now())

  interviews  Interview[]
  offerLetter OfferLetter?

  @@map("applications")
}

model Interview {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  interviewerIds String      // comma-separated user IDs
  scheduledDate  DateTime
  duration       Int         @default(60) // minutes
  type           String      @default("VIDEO") // PHONE, VIDEO, ONSITE, PANEL, TECHNICAL
  status         String      @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  feedback       String?
  rating         Int?
  location       String?
  createdAt      DateTime    @default(now())

  @@map("interviews")
}

model OfferLetter {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  salary        Float
  startDate     DateTime
  expiryDate    DateTime?
  benefits      String?
  status        String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED, EXPIRED
  terms         String?
  createdAt     DateTime    @default(now())

  @@map("offer_letters")
}

