# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production-ready):
DATABASE_URL="postgresql://user:password@localhost:5432/pharma_erp"
# SQLite (development fallback):
# DATABASE_URL="file:./dev.db"

# Connection pool size (PostgreSQL only)
# DB_POOL_SIZE=10

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Multi-tenant (optional) ────────────────────────────────────────────────
# MASTER_DATABASE_URL="file:./prisma/master.db"

# ─── Email / SMTP (optional) ────────────────────────────────────────────────
# If SMTP_HOST is not set, emails are logged to the console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pharmacrm.com

# ─── AI / LLM (optional) ────────────────────────────────────────────────────
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"
