# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev
MASTER_DATABASE_URL=file:./prisma/master.db
# DB_POOL_SIZE=10

# Authentication
NEXTAUTH_SECRET=change-me-in-production-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# Application
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
# APP_VERSION=1.0.0

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_MASTER_KEY=change-me-32-byte-hex-key-for-field-encryption
# ENCRYPTION_KEYS={"key1":"base64-encoded-32-byte-key"}
# ENCRYPTION_DEFAULT_KEY_ID=key1

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com

# AI (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama - local AI (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Storage (optional)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring (optional)
SENTRY_DSN=
