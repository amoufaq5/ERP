# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev

# Authentication
NEXTAUTH_SECRET=change-me-in-production-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# Application
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_MASTER_KEY=change-me-32-byte-hex-key-for-field-encryption

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com

# AI (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage (optional)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring (optional)
SENTRY_DSN=
